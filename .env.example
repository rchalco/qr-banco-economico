ConnectionStrings__BanecoDb="Server=localhost;Database=qr-banco-economico;User Id=sa;Password=<password>;TrustServerCertificate=True;Encrypt=False"
Baneco__BaseUrl="https://apimkt.baneco.com.bo/apiGateway/"

# --- Escucha del servicio ----------------------------------------------------
# Interfaz y puerto de Kestrel. Host admite: 0.0.0.0 (todas las interfaces), localhost (solo loopback)
# o una IP concreta de la máquina, por ejemplo 10.20.30.40, para publicar en una sola tarjeta de red.
# Fijar ambos tiene prioridad sobre ASPNETCORE_URLS y sobre launchSettings.json; si se omiten los dos,
# manda ASPNETCORE_URLS. Detrás de un proxy inverso, escuche en localhost y publique solo el proxy.
Service__Host="0.0.0.0"
Service__Port="5000"

# --- Llave maestra -----------------------------------------------------------
# Cifra el usuario y la contraseña de Baneco que se guardan en BanecoAccounts.
# Genérela con: openssl rand -base64 32 > src/QrBancoEconomico.Api/secrets/baneco-master.key
# El archivo está en .gitignore y NO debe subirse: quien lo tenga descifra las credenciales del banco.
# Guarde una copia en la bóveda institucional; sin ella hay que volver a cargar las credenciales.
Baneco__MasterKeyFile="secrets/baneco-master.key"
# Alternativa para contenedores; tiene prioridad sobre el archivo. Solo por variable de entorno, nunca en .env versionado.
# Baneco__MasterKey="<32 bytes en Base64>"

# --- Token de Baneco ---------------------------------------------------------
# El proxy autentica solo con las credenciales cifradas de cada cuenta y renueva el token antes de que venza.
# Vida asumida cuando el banco no informa exp; Baneco emite con 30 minutos.
Baneco__TokenLifetimeMinutes="30"
# Margen de renovación anticipada, en segundos.
Baneco__TokenRenewMarginSeconds="300"
# Baneco__AuthenticatePath="api/authentication/authenticate"

# --- Respaldos heredados (evítelos) ------------------------------------------
# Tokens estáticos: vencen a los 30 minutos y NO se renuevan solos; obligan a reiniciar el servicio.
# Solo se consultan si la cuenta no tiene usuario y contraseña cargados en el inventario.
# Baneco__BearerToken="<token-temporal-del-banco>"
# Baneco__Accounts__recaudos01__BearerToken="<token de la cuenta recaudos-01>"

# --- API Keys del proxy ------------------------------------------------------
# Etiqueta de ambiente incrustada en las API Keys (dev/stg/prd). Si se omite se deriva de ASPNETCORE_ENVIRONMENT.
# Una clave emitida para un ambiente es rechazada en cualquier otro.
ApiKeys__Environment="dev"
# Vigencia de la caché de validación en segundos: acota el retardo de una revocación entre instancias.
ApiKeys__CacheSeconds="60"
# Cuota por minuto para el tráfico sin credencial válida (health y rechazos), particionada por IP.
ApiKeys__AnonymousRequestsPerMinute="60"
# Habilite en true una única vez para emitir la clave administrativa inicial; se imprime por consola y no se recupera.
ApiKeys__BootstrapAdminKey="false"
